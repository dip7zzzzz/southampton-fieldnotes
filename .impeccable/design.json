      "css": ".ds-row{display:flex;align-items:center;gap:10px;width:100%;padding:14px 7px;text-align:left;border:0;border-bottom:1px solid var(--line,#dce4d8);border-radius:0;background:var(--soft,#eaf0e3);font-family:\"Segoe UI\",system-ui,sans-serif;color:var(--ink,#203e30);cursor:pointer}.ds-rank{font-size:11px;color:var(--muted,#536655);width:29px;font-variant-numeric:tabular-nums}.ds-name{font-size:13px;font-weight:600;flex:1}.ds-score{font-size:21px;font-weight:650;letter-spacing:-.025em;color:var(--green,#245a3b);font-variant-numeric:tabular-nums}.ds-score small{display:block;font-size:9px;font-weight:400;letter-spacing:0;margin-top:3px;color:var(--muted,#536655)}.ds-row:focus-visible{outline:3px solid #709345;outline-offset:3px}.ds-row:active{filter:brightness(.94)}@media(hover:hover) and (pointer:fine){.ds-row:hover{background:var(--soft,#eaf0e3)}}@media(max-width:720px){.ds-row{min-height:90px}.ds-name{font-size:14px}}"

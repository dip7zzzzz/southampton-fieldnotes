      "css": ".ds-segments{display:flex;padding:3px;gap:3px;background:var(--soft,#eaf0e3);border-radius:8px}.ds-segments button{font:12px \"Segoe UI\",system-ui,sans-serif;flex:1;min-height:35px;padding:7px 3px;border:0;border-radius:6px;background:transparent;color:var(--muted,#536655);white-space:nowrap;cursor:pointer}.ds-segments button[aria-pressed=\"true\"]{background:var(--ink,#203e30);color:var(--surface,#ffffff)}.ds-segments button:focus-visible{outline:3px solid #709345;outline-offset:3px}.ds-segments button:active{filter:brightness(.94)}@media(max-width:720px){.ds-segments button{min-height:44px}}@media(prefers-color-scheme:dark){.ds-segments button[aria-pressed=\"true\"]{background:var(--green,#c2dda7);color:var(--paper,#1b2922)}}"

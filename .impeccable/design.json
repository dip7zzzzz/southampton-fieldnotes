      "html": "<button class=\"ds-primary\">Explore areas</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 14px;border-radius:8px;font:600 12px \"Segoe UI\",system-ui,sans-serif;cursor:pointer;text-decoration:none;border:0;background:var(--ink,#203e30);color:var(--surface,#ffffff)}.ds-primary:focus-visible{outline:3px solid #709345;outline-offset:3px}.ds-primary:active{filter:brightness(.94)}@media(hover:hover) and (pointer:fine){.ds-primary:hover{filter:brightness(1.12)}}@media(prefers-color-scheme:dark){.ds-primary{background:var(--green,#c2dda7);color:var(--paper,#1b2922)}}"
